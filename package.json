{
  "name": "albasera-player",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:replit": "expo start --web --port 5000",
    "lint": "expo lint",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:tv": "eas build --platform android --profile tv-preview",
    "build:production:tv": "eas build --platform all --profile tv-production",
    "build:production": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.13.5",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "hls.js": "^1.6.15",
    "mpegts.js": "^1.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "npm:react-native-tvos@^0.81.5-2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vlc-media-player": "^1.0.98",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-tv-space-navigation": "^6.0.0-beta1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.5",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
