modules = ["nodejs-20", "java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["glib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_LOCAL_DEV=1 NODE_PATH=\"$(npm root -g)\" npx expo start --tunnel --go --clear"

[[workflows.workflow]]
name = "Web Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_LOCAL_DEV=1 NODE_PATH=\"$(npm root -g)\" npx expo start --web --port 5000 --clear"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 8081
