   implementation "androidx.media3:media3-ui:${androidxMedia3Version}"
   implementation "androidx.media3:media3-datasource-okhttp:${androidxMedia3Version}"
 
+  // MP2 (MPEG Layer II) audio fallback for Media3, used only when the platform
+  // MediaCodec can't decode a format (see VideoPlayer.kt's
+  // setExtensionRendererMode(EXTENSION_RENDERER_MODE_ON)). Vendored at
+  // modules/decoder-ffmpeg-mp2 (repo root) instead of node_modules, since this
+  // file only survives via patch-package (node_modules is not reproducible).
+  implementation project(':decoder-ffmpeg-mp2')
